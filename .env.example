# ============================================
# Configuration Local Agents
# Copie ce fichier : cp .env.example .env
# ============================================

# Discord Bot (bot Jarvis)
DISCORD_TOKEN=

# CyberDefence alertes Discord
CYBERDEFENCE_DISCORD_WEBHOOK=

# Email SMTP (optionnel)
EMAIL_USER=
EMAIL_PASS=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Twitter/X (optionnel)
TWITTER_API_KEY=
TWITTER_API_SECRET=

# LinkedIn (optionnel)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# GPU
GPU_ENABLED=false
GPU_TYPE=cpu

# Logging
LOG_LEVEL=info
"@ | Set-Content .env.example -NoNewline
